# QuantCore Environment Configuration
# Copy to .env and fill in values

# Database
DATABASE_URL=postgresql://quantcore:quantcore@localhost:5432/quantcore
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# Kafka
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC_PREFIX=quantcore

# Data Sources
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=wss://stream.data.alpaca.markets

POLYGON_API_KEY=

ALPHA_VANTAGE_API_KEY=

FRED_API_KEY=

# Brokers
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Environment
QUANTCORE_ENV=development
