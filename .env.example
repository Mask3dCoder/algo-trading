# QuantCore Environment Configuration
# Copy to .env and fill in values
# .env is git-ignored — never commit real secrets

# =========================================================================
# Database — TimescaleDB (required for historical data + audit trail)
# =========================================================================
# Required for: data storage, audit trail persistence, analytics
DATABASE_URL=postgresql://quantcore:quantcore@localhost:5432/quantcore
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# =========================================================================
# Redis — caching + pub/sub (required for live trading, optional for backtest)
# =========================================================================
# Required for: live feed aggregation, real-time state, pub/sub signaling
REDIS_URL=redis://localhost:6379/0

# =========================================================================
# Kafka — message broker (optional, for distributed event streaming)
# =========================================================================
# Optional: only needed if running a multi-process distributed architecture
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC_PREFIX=quantcore

# =========================================================================
# Alpaca — market data + broker (required for live; not needed for backtest)
# =========================================================================
# Paper trading URL: https://paper-api.alpaca.markets
# Live trading URL: https://api.alpaca.markets
# Get keys: https://app.alpaca.markets/
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=wss://stream.data.alpaca.markets
# Set to true to confirm live trading intent (safety gate)
ALPACA_LIVE_TRADING=false

# =========================================================================
# Polygon.io — reference + options data (optional)
# =========================================================================
# Optional: alternative data source for equities and options
# Get keys: https://polygon.io/
POLYGON_API_KEY=your_polygon_api_key_here

# =========================================================================
# Alpha Vantage — fundamentals (optional)
# =========================================================================
# Optional: free tier is 25 requests/day
# Get keys: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# =========================================================================
# FRED — macroeconomic data (optional)
# =========================================================================
# Optional: Federal Reserve Economic Data
# Get keys: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# =========================================================================
# Interactive Brokers — alternative broker (optional)
# =========================================================================
# Optional: TWS or IB Gateway must be running locally
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# =========================================================================
# Logging
# =========================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# =========================================================================
# Environment
# =========================================================================
# development: debug logging, paper trading URLs, permissive CORS
# production:  warning logging, live trading URLs, restrictive CORS
QUANTCORE_ENV=development

# =========================================================================
# Alerting (optional)
# =========================================================================
# Optional: Telegram alerts for trade events, kill switch, errors
# Setup: message @BotFather on Telegram to create a bot and get the token
# Then run: python -c "from quantcore.alerts.telegram_alert import get_my_chat_id; get_my_chat_id()"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: Slack webhook for alert notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# Optional: SMTP for email alerts
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=alerts@example.com
# SMTP_PASSWORD=your_smtp_password_here
